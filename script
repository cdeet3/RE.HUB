task.spawn(function()
    local needsWaypoint = true
    while true do
        if UI.GetValue("wreck_on") then
            local ready, hrp = isCharacterReady(player.Character)
            if not ready then
                currentTargetModel = nil
                needsWaypoint = true
                repeat
                    task.wait(0.5)
                    local r = isCharacterReady(player.Character)
                until r or not UI.GetValue("wreck_on")
                task.wait(1.5)
                continue
            end
            if needsWaypoint then
                interfaceTeleport:FireServer("Teleport", "Mine Shop")
                hrp.CFrame = CFrame.new(4520, 101, -760)
                task.wait(1)
                needsWaypoint = false
                continue
            end
            local targetPos, targetModel = findWreckModelAndPosition()
            if targetPos and targetModel then
                local readyNow, currentHrp = isCharacterReady(player.Character)
                if readyNow then
                    local startPos = currentHrp.Position
                    local safePos = targetPos + Vector3.new(0, 2, 0)
                    local finalCFrame = CFrame.new(safePos.X, safePos.Y, safePos.Z)
                    if targetModel ~= currentTargetModel then
                        currentTargetModel = targetModel
                        local glideHeight = math.max(startPos.Y, safePos.Y) + 300
                        local startCFrame = CFrame.new(startPos.X, startPos.Y, startPos.Z)
                        local highMidCFrame = CFrame.new(safePos.X, glideHeight, safePos.Z)
                        local dx = startPos.X - safePos.X
                        local dz = startPos.Z - safePos.Z
                        local horizontalDist = math.sqrt(dx * dx + dz * dz)
                        local speed = 150
                        local duration1 = math.max(horizontalDist / speed, 0.1)
                        local startTime1 = os.clock()
                        while UI.GetValue("wreck_on") and targetModel and targetModel.Parent do
                            local rCheck, hrpCheck = isCharacterReady(player.Character)
                            if not rCheck then break end
                            local elapsed = os.clock() - startTime1
                            local alpha = math.clamp(elapsed / duration1, 0, 1)
                            hrpCheck.CFrame = startCFrame:Lerp(highMidCFrame, alpha)
                            if alpha >= 1 then
                                break
                            end
                            task.wait()
                        end
                        if not UI.GetValue("wreck_on") then continue end
                        local descentDuration = 2.0
                        local startTime2 = os.clock()
                        while UI.GetValue("wreck_on") do
                            local rCheck, hrpCheck = isCharacterReady(player.Character)
                            if not rCheck then break end
                            local elapsed = os.clock() - startTime2
                            local alpha = math.clamp(elapsed / descentDuration, 0, 1)
                            hrpCheck.CFrame = highMidCFrame:Lerp(finalCFrame, alpha)
                            if alpha >= 1 then
                                break
                            end
                            task.wait()
                        end
                    end
                    if not UI.GetValue("wreck_on") then continue end
                    local stayStartTime = os.clock()
                    local stayDuration = 8.0
                    while UI.GetValue("wreck_on") do
                        local rCheck, hrpCheck = isCharacterReady(player.Character)
                        if not rCheck then break end
                        if os.clock() - stayStartTime >= stayDuration then
                            table.insert(recentCleanedPositions, {pos = targetPos, time = os.clock()})
                            visitedModels[targetModel] = true
                            break
                        end
                        hrpCheck.CFrame = finalCFrame
                        task.wait(0.5)
                    end
                    if currentTargetModel == targetModel then
                        currentTargetModel = nil
                    end
                end
            else
                currentTargetModel = nil
                task.wait(1)
            end
        else
            task.wait(0.5)
        end
    end
end)
