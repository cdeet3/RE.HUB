local function tapKey(vk, seconds)
    pcall(keypress, vk)
    task.wait(seconds)
    pcall(keyrelease, vk)
end
local function isCharacterReady(char)
    if not char then return false, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return true, hrp
    end
    return false, nil
end
local function getWreckContainer()
    local containers = workspace:FindFirstChild("Containers")
    if not containers then return nil end
    local tsContainer = containers:FindFirstChild("TrainStationContainer")
    if not tsContainer then return nil end
    local rsContainer = tsContainer:FindFirstChild("RuinedStationContainer")
    if not rsContainer then return nil end
    return rsContainer:FindFirstChild("WreckContainer")
end
local function findWreckModelAndPosition()
    local wreckContainer = getWreckContainer()
    if not wreckContainer then return nil, nil end
    local tiersToSearch = {}
    for i = 1, 5 do
        if UI.GetValue("mine_tier" .. i) then
            table.insert(tiersToSearch, "Tier" .. i)
        end
    end
    for _, tierName in ipairs(tiersToSearch) do
        local tierFolder = wreckContainer:FindFirstChild(tierName)
        if tierFolder then
            for _, obj in pairs(tierFolder:GetDescendants()) do
                if obj.Name == "WreckModel" and not visitedModels[obj] then
                    local lowestY = math.huge
                    local lowestPos = nil
                    for _, part in pairs(obj:GetDescendants()) do
                        if part:IsA("BasePart") then
                            local success, cf = pcall(function() return part.CFrame end)
                            if success and cf then
                                local pos = cf.Position
                                if pos and pos.Y < lowestY then
                                    lowestY = pos.Y
                                    lowestPos = pos
                                end
                            end
                        end
                    end
                    if lowestPos then
                        if lowestPos.Y < -500 then
                            visitedModels[obj] = true
                        else
                            local skipThis = false
                            local currentTime = os.clock()
                            for _, data in ipairs(recentCleanedPositions) do
                                if currentTime - data.time < 20 and (data.pos - lowestPos).Magnitude < 15 then
                                    skipThis = true
                                    break
                                end
                            end
                            if not skipThis then
                                return lowestPos, obj
                            else
                                visitedModels[obj] = true
                            end
                        end
                    end
                end
            end
        end
    end
    return nil, nil
end
